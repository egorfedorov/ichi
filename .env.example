# ── ichi, self-hosted ────────────────────────────────────────────────────
#
#   cp .env.example .env
#   docker compose up
#
# Then open http://localhost:3400. Only the values marked REQUIRED actually
# need your attention.

# Local database — the compose file wires this up for you.
DATABASE_URL=postgres://ichi:ichi@localhost:5433/ichi
POSTGRES_PASSWORD=ichi

# REQUIRED for reflection jobs — the model that re-reads what the soul lived
# through and commits personality drift. Any Anthropic-compatible reseller
# works via ANTHROPIC_BASE_URL. Unset, souls still live and decay; they just
# never reflect.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.apimart.ai

# REQUIRED — session signing. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Where this instance lives. Keep as-is for local use.
BETTER_AUTH_URL=http://localhost:3400
NEXT_PUBLIC_APP_URL=http://localhost:3400

# Cheap model for reflection. Haiku is the point: reflection runs often.
MODEL_JUDGE=claude-haiku-4-5

# Optional. Without GitHub keys, sign-in falls back to email/password
# (no mail provider in MVP, so password reset is unavailable).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
